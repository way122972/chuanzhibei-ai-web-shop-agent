# 智能电商导购平台 —— 环境变量示例
# 用法：复制本文件为 .env（properties 格式，后端启动时通过 spring.config.import 自动加载），
# 填入真实密钥后启动后端；也可以不建 .env，直接在系统里 setx / export。
# 注意：系统环境变量优先级高于 .env 文件；.env 已加入 .gitignore，不会被提交。

# ===== DeepSeek 大模型（必需，AI 助手对话） =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 视觉模型（可选，默认 deepseek-flash，图片分析使用）
DEEPSEEK_VISION_MODEL=deepseek-flash

# ===== 阿里云 OSS（图片上传 / AI 图片分析依赖） =====
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# ===== 预留：向量化 / Embedding 服务 Key（后续语义检索功能使用） =====
# EMBEDDING_API_KEY=
