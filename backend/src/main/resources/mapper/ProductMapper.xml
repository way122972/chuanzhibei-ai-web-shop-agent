<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    商品 Mapper 映射文件
    对应的接口：com.shopguide.mapper.ProductMapper
    说明：接口中只保留方法签名，所有手写 SQL（含多表关联、动态条件）统一写在本文件，
         分页由 MyBatis-Plus 的 PaginationInnerInterceptor 自动拼接 count 与 LIMIT。
-->
<mapper namespace="com.shopguide.mapper.ProductMapper">

    <!-- 商品结果映射：product 表字段 + 关联查询出来的分类名称 category_name -> categoryName -->
    <resultMap id="ProductWithCategoryMap" type="com.shopguide.entity.Product">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="image" property="image"/>
        <result column="category_id" property="categoryId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="category_name" property="categoryName"/>
    </resultMap>

    <!-- 公共查询字段：商品基础字段 + 分类名称 -->
    <sql id="Base_Column_List">
        p.id, p.name, p.price, p.image, p.category_id, p.status,
        p.create_time, p.update_time, c.name AS category_name
    </sql>

    <!--
        多表关联分页查询
        product LEFT JOIN category，支持：分类过滤、名称模糊、价格区间
        参数：page(分页对象) + categoryId/name/minPrice/maxPrice
    -->
    <select id="selectPageWithCategory" resultMap="ProductWithCategoryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM product p
        LEFT JOIN category c ON p.category_id = c.id
        <where>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
            <if test="name != null and name != ''">
                AND p.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="minPrice != null">
                AND p.price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND p.price &lt;= #{maxPrice}
            </if>
        </where>
        ORDER BY p.create_time DESC, p.id DESC
    </select>

</mapper>
